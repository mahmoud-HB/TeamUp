# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# Ne jamais committer de vraies clés : .env.local est ignoré par git.

# --- Supabase ---
# URL et clé publique (anon) de votre projet Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé de service (SERVEUR UNIQUEMENT, jamais exposée au client) — requise
# pour les opérations admin (ex. back-office de modération, étapes futures).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Développement uniquement ---
# Active un bouton "Connexion test (dev)" sur la page de connexion qui
# contourne l'authentification Supabase (aucune session réelle créée) afin
# de visualiser l'UI sans backend fonctionnel.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false

# Désactivé par défaut : par sécurité, NEXT_PUBLIC_ENABLE_DEV_LOGIN seul
# est ignoré en production (NODE_ENV=production). Pour autoriser malgré
# tout une démo publique en ligne (ex. déploiement Vercel sans Supabase
# réel, données 100% fictives), positionnez EXPLICITEMENT les deux
# variables à "true". Ne jamais faire ça sur un déploiement connecté à un
# vrai projet Supabase / de vraies données utilisateur.
NEXT_PUBLIC_ALLOW_PUBLIC_DEMO=false
